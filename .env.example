# Скопируйте в .env и заполните. Файл .env не коммитить.

# Ключ Google AI Studio (https://aistudio.google.com/apikey).
# Пусто — ИИ-консультант работает в демо-режиме без модели.
AI_API_KEY=

# OpenAI-совместимый эндпоинт и модель (значения по умолчанию — Gemini).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# Сервер. На VPS за локальным запуском оставьте 127.0.0.1; 0.0.0.0 — для доступа снаружи.
HOST=127.0.0.1
PORT=8000

DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
