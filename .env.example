# Скопируйте в .env и заполните. Файл .env не коммитить.

# Ключ Google AI Studio (https://aistudio.google.com/apikey).
# Пусто — ИИ-консультант работает в демо-режиме без модели.
AI_API_KEY=

# OpenAI-совместимый эндпоинт и модель (значения по умолчанию — Gemini).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite

# Только для Yandex AI Studio (доступен из РФ; Google API из РФ не работает):
#   AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   AI_MODEL=gpt://<ID_каталога>/yandexgpt/latest
#   AI_PROJECT=<ID_каталога>
AI_PROJECT=

# Защита от перегрузки и расхода квоты модели.
# Запросов в минуту с одного IP.
RATE_LIMIT_PER_MIN=60
# Вопросов консультанту в минуту с одной сессии.
AI_RATE_PER_MIN=10
# Вопросов консультанту в сутки на весь сервер.
AI_DAILY_LIMIT=300

# Хранение данных.
# Через сколько дней заявки и отзывы удаляются автоматически.
RETENTION_DAYS=365
# Сколько часов хранится состояние диалога.
SESSION_TTL_HOURS=6
# Сколько резервных копий базы хранить.
BACKUP_KEEP=14

# Уведомление менеджера о новой заявке в Telegram (необязательно, см. README).
# Токен выдаёт @BotFather, chat id — ваш числовой id или id группы. Токен храните только в .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сервер. На VPS за локальным запуском оставьте 127.0.0.1; 0.0.0.0 — для доступа снаружи.
HOST=127.0.0.1
PORT=8000

DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
